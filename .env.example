# Bot token from @BotFather / 从 @BotFather 获取的 Bot Token（必填）
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxx

# Bot message language: zh or en / bot 消息语言
BOT_LANG=zh

# OpenAI-compatible endpoint / OpenAI 兼容接口地址
# LM Studio: http://localhost:1234/v1   vLLM: http://localhost:8000/v1
# Official OpenAI: https://api.openai.com/v1
# Inside Docker, use http://host.docker.internal:port/v1 to reach the host
LLM_BASE_URL=http://localhost:1234/v1

# Model name / 模型名称（LM Studio 服务器页面或 vLLM --model 指定的名称）
LLM_MODEL=local-model

# Most local servers accept anything / 本地服务一般随便填；官方 API 填真实 key
LLM_API_KEY=not-needed

# Custom User-Agent for LLM requests (some cloud gateways validate it)
# 可选：自定义请求 UA（部分云端网关会校验），留空使用 SDK 默认值
# LLM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Optional system prompt / 可选：系统提示词（不填使用内置默认值）
# Write it on ONE line and use \n for line breaks; wrap it in double quotes.
# The bot also turns a literal \n into a line break when the value is unquoted.
# 写在一行里，用 \n 表示换行，并用双引号包起来；没加引号时 bot 也会把字面的 \n 当换行。
# SYSTEM_PROMPT="You are a helpful group chat assistant.\n\nKeep replies short."

# Max tokens per reply / 单次回答的最大 token 数
MAX_TOKENS=1024

# Sampling temperature (0-2, higher = livelier and less mechanical; empty =
# backend default). Models that only accept the default reject the param — the
# bot detects that and drops it automatically.
# 采样温度（0~2，越高越活泼、越不机械；留空=后端默认。模型只接受默认值时会自动去掉该参数）
# LLM_TEMPERATURE=0.9

# Nucleus sampling / 核采样 top_p（0~1，留空=后端默认）
# LLM_TOP_P=0.95

# Extra request-body fields (a JSON object) passed through verbatim by
# OpenAI-compatible and native Claude requests, for vendor-specific params such
# as a thinking budget or reasoning effort. Auto-dropped if the backend rejects
# them. Ignored in Gemini native mode.
# 额外请求体参数（JSON 对象）：OpenAI 兼容与 Claude 原生请求会原样透传，用于
# thinking、reasoning_effort 等厂商私有参数；后端拒绝时自动去掉。Gemini 原生模式忽略
# LLM_EXTRA_BODY={"reasoning_effort":"low"}
# LLM_EXTRA_BODY={"thinking":{"type":"enabled","budget_tokens":1000}}

# Messages kept per conversation / 每条对话链保留的最大消息条数
MAX_HISTORY=20

# Replying to a bot message picks up its conversation for this many days, also after restarts (the
# history is stored as text in memory.db; images in it are replaced by a placeholder).
# 回复 bot 多少天以内的消息还能接上上下文（重启后也能；对话历史以纯文本存在 memory.db，图片换成占位）
# CONVERSATION_KEEP_DAYS=7

# Log files: one per day in LOG_DIR (default: logs/ next to the whitelist file, i.e. ./data/logs in
# Docker), kept LOG_KEEP_DAYS days; 0 = console only.
# 日志文件：每天一个，写在 LOG_DIR（默认白名单文件旁的 logs/，Docker 里就是 ./data/logs），留 LOG_KEEP_DAYS 天；0 = 只输出到控制台
# LOG_DIR=/data/logs
# LOG_KEEP_DAYS=14

# Long-term memory, kept per chat (modeled on Hermes Agent / OpenClaw):
#   - chat log: Q&A with the bot and overheard group messages, stored verbatim in SQLite with full-text
#     search; the model looks up exact past messages with the recall tool. Kept MEMORY_ARCHIVE_DAYS days.
#   - curated entries: group notes and a profile per person, stored one entry at a time with character
#     limits. The model adds/updates/removes them during chats with the memory tool, and a background pass
#     reads new log messages and proposes changes (never rewrites everything at once).
#   New conversations start with the group notes plus the asker's and quoted person's profiles.
#   Stored in memory.db next to the whitelist file (/data in Docker), together with follow-up history,
#   recent group chat, and usage stats; an old memory.json is migrated once.
#   Commands: /memory, /forget [entry numbers], /forgetme.
# 长期记忆（按聊天分开，参照 Hermes Agent / OpenClaw）：
#   - 原始记录：和 bot 的问答、旁听群的消息原样存进 SQLite 全文索引，模型用 recall 工具查原话，保留 MEMORY_ARCHIVE_DAYS 天
#   - 精选条目：群笔记和每个人的档案，一条一条存、有字数上限；模型聊天中用 memory 工具增改删，
#     后台定期读新记录提出增改删（不整段重写）
#   新对话开头注入群笔记、提问者和被引用者的档案。存在白名单文件旁的 memory.db（Docker 下在 /data），
#   旧的 memory.json 首次启动时自动迁移。命令：/memory、/forget [编号]、/forgetme
MEMORY_ENABLED=true
# Character limits: group notes per chat, and each person's profile per chat
# 字数上限：每个聊天的群笔记、每个人在每个聊天的档案
# MEMORY_GROUP_CHARS=1500
# MEMORY_PROFILE_CHARS=500
# Days to keep the chat log / 原始记录保留天数
# MEMORY_ARCHIVE_DAYS=90
# Background pass: at most every N minutes per chat, once N new log messages pile up (or a day has passed)
# 后台整理：每个聊天最多每多少分钟一次，攒够多少条新记录才整理（放了一天的零星记录也整理）
# MEMORY_CONSOLIDATE_INTERVAL=60
# MEMORY_CONSOLIDATE_MIN=10

# Silent observation: in these groups (comma-separated chat ids; /memory shows the id) the bot also
# stores messages that don't mention it in the chat log, without replying or calling the model per
# message; the background pass curates them. Requires privacy mode off in BotFather (/setprivacy -> Disable,
# then re-add the bot to the group) or making the bot a group admin.
# 静默旁听：列出的群（逗号分隔的群 id，/memory 会显示）里，没 @ bot 的消息也存进原始记录，不回复、不逐条请求模型，
# 由后台整理。需要在 BotFather 关闭隐私模式（/setprivacy → Disable，然后把 bot 移出群再拉回来），或把 bot 设为群管理员
# MEMORY_OBSERVE_CHATS=-1001234567890

# Slang glossary: once the model works out how a meme, slang term, or metaphor is used (from a page or
# because someone corrected it), it saves that usage with the remember_slang tool, together with when it
# carries that meaning and the original message; a term keeps up to 3 usages. Later messages containing the
# term get those usages attached as a reference to judge against the current context (only matching terms,
# up to 5). General memes are shared by all chats, group in-jokes stay in their group.
# Teach by hand with /learn term=meaning|when it means this.
# 梗词典：模型弄明白一个梗、黑话或隐喻的某种用法后（或者被群友纠正后），用 remember_slang 记下这种用法，
# 连同「什么语境下是这个意思」和当时的原句；一个词最多留 3 种用法。之后消息里出现这个词，
# 就把这些用法作为参考附上，让模型对照当前语境判断（只附命中的，最多 5 个词）。通用梗所有群共享，
# 群内梗只在本群用。群友可以用 /learn 词=解释|语境 手动教。存在白名单文件旁的 slang.json
SLANG_ENABLED=true
# SLANG_MAX_ENTRIES=500

# Image understanding for vision-capable models / 图片理解（需模型支持视觉输入）
ENABLE_VISION=false

# Videos and voice messages: the main model gets a watch_media tool that hands videos, GIFs, round
# videos, voice messages, and audio (and images when ENABLE_VISION is off) to this Gemini model, which
# returns a transcript and description. Uses GEMINI_BASE_URL / GEMINI_API_KEY below. Files over 20 MB
# can't be downloaded by bots. Not used with LLM_PROTOCOL=gemini.
# 看视频、听语音：主模型拿到 watch_media 工具，把视频、GIF、圆形视频、语音、音频（没开视觉时也包括图片）
# 交给这个 Gemini 模型看/听，拿回转写和画面描述。用下方 GEMINI_BASE_URL / GEMINI_API_KEY；
# 超过 20MB 的文件 bot 下载不了；主模型走 LLM_PROTOCOL=gemini 时不生效
# GEMINI_MEDIA_MODEL=gemini-2.5-flash
# Prefetch: as soon as a video/voice message appears, Gemini transcribes it in the background, so
# questions about it are answered without a tool round. 预读：视频语音一出现就在后台让 Gemini 转述，问到时直接用
# MEDIA_PREFETCH=true

# Gemini helper (uses GEMINI_BASE_URL / GEMINI_API_KEY; empty = reuse GEMINI_MEDIA_MODEL): memory
# consolidation runs on it instead of the main model.
# Gemini 帮手模型（走 GEMINI_BASE_URL / GEMINI_API_KEY；留空沿用 GEMINI_MEDIA_MODEL）：记忆整理改用它，不占主模型
# GEMINI_HELPER_MODEL=gemini-3-flash

# Recent group chat: every group message the bot receives is stored (only the last RECENT_CHAT_MINUTES,
# kept across restarts) and the latest ones are attached to questions, each line labeled with who said it
# and whom they replied to, so "what did they just say" works. 0 = off.
# 最近群聊：bot 收到的群消息存进数据库（只留 RECENT_CHAT_MINUTES 分钟内的，重启不丢），提问时附上最近几条，每行标明谁说的、回复谁。0 = 关闭
# RECENT_CHAT_COUNT=15
# RECENT_CHAT_MINUTES=60

# Max images attached per request (albums are expanded) / 单次请求最多附带的图片数（相册会展开为整组）
# MAX_IMAGES=4

# Web search: lets the model search the internet via the web_search tool and
# read pages via the open_url tool
# (requires a model/backend with function calling support; auto-disabled otherwise).
# Providers / 搜索源:
#   tavily     - hosted, LLM-optimized, free tier ~1000/mo, needs API key from https://tavily.com
#   duckduckgo - no key needed (uses the `ddgs` package, already in requirements.txt)
#   searxng    - self-hosted SearXNG instance (JSON output format must be enabled)
#   serper     - real Google results via https://serper.dev (2500 free queries), needs API key
# Multiple providers can be combined with commas — results are fetched
# concurrently, deduplicated and interleaved. e.g. SEARCH_PROVIDER=serper,tavily
# Empty = disabled (default) / 留空 = 关闭联网搜索
# 联网搜索：开启后模型可通过 web_search 搜索、open_url 读取网页（需模型支持 function calling）
# 可逗号分隔配置多个源，并发聚合、去重、交错合并结果
SEARCH_PROVIDER=
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
# SERPER_API_KEY=xxxxxxxxxxxxxxxx
# SEARXNG_BASE_URL=http://localhost:8080

# Wire protocol for the reply model, one key / 主模型协议（单键指定，留空 = openai）:
#   openai    - OpenAI-compatible /chat/completions (default: relays, LM Studio, vLLM,
#               official OpenAI)
#   responses - OpenAI Responses API /responses. Required for tool calling on models
#               that only support tools there (e.g. gpt-6.1-sol); the bot's own tool
#               loop keeps working. Reasoning effort goes in LLM_EXTRA_BODY as
#               {"reasoning":{"effort":"low"}}.
#   gemini    - native Gemini API via the google-genai SDK. Google runs google_search +
#               url_context server-side (higher precision); the bot's own
#               web_search/open_url tools are bypassed. Needs an AI Studio key and a
#               gemini-* model.
#   claude    - native Anthropic Messages API via the anthropic SDK: real thinking
#               blocks and native tool-use semantics; the bot's own tool loop keeps
#               working. Needs a claude-* model.
#   responses：OpenAI Responses API，GPT-6.1 Sol 等只在 /responses 上支持工具调用的模型必须用它；
#   推理强度写在 LLM_EXTRA_BODY={"reasoning":{"effort":"low"}}
# Endpoint selection / 接口地址：
#   openai, responses, claude - use LLM_BASE_URL (a trailing /v1 is stripped for claude)
#   gemini                    - use GEMINI_BASE_URL below (empty = official Google endpoint)
#   openai、responses、claude 使用 LLM_BASE_URL（claude 会剥离末尾 /v1）；
#   gemini 使用下方 GEMINI_BASE_URL（留空连接 Google 官方）
# LLM_PROTOCOL=openai

# Fallback model: if the primary model errors before producing any text, that reply is
# retried on this model and ends with a note saying so. Empty = disabled. Protocol, URL,
# and key default to the primary model's; extra params are NOT inherited.
# 备用模型：主模型还没输出正文就出错时，这条回复改用备用模型，并在末尾注明。留空 = 不启用。
# 协议、地址、key 留空沿用主模型；额外参数不继承，按 LLM_FALLBACK_EXTRA_BODY
# （python configure.py 第 8.5 步可以菜单式填写，不用手写 JSON）
# LLM_FALLBACK_MODEL=gpt-5-mini
# LLM_FALLBACK_PROTOCOL=openai
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_EXTRA_BODY={"reasoning_effort":"low"}

# Hybrid mode: run web_search on a dedicated grounding model (free tier allows
# grounding on the 2.5 family) while replies use LLM_MODEL. Falls back to the
# providers above on quota errors. Not used with LLM_PROTOCOL=gemini (search is native there).
# 混合模式：web_search 由该 grounding 模型执行（免费档 2.5 系列可用），回复用 LLM_MODEL；
# 配额超限自动回退上面的搜索源
# GEMINI_SEARCH_MODEL=gemini-2.5-flash
# Gemini API key for grounding and GEMINI_MEDIA_MODEL, decoupled from the main model (use when
# LLM_API_KEY is a relay/local key); empty = reuse LLM_API_KEY
# grounding 和 GEMINI_MEDIA_MODEL 用的 Gemini key（主模型走中转站/本地时填写）；留空复用 LLM_API_KEY
# GEMINI_API_KEY=AIzaSyxxxxxxxx
# Gemini native API base URL: empty = official Google endpoint. Set this if your
# relay can forward the native Gemini format (applies to native mode, grounded
# search, and GEMINI_MEDIA_MODEL).
# Gemini 原生接口地址：留空连 Google 官方；中转站支持转发原生格式时填其地址
# （原生模式、grounding 搜索和看媒体都会走这里）
# GEMINI_BASE_URL=https://your-relay.example.com

# Search results fed back to the model per query / 单次搜索回灌给模型的结果条数
SEARCH_MAX_RESULTS=5

# Max page text characters fed back per open_url call / 单次读取网页回灌给模型的正文字数上限
# FETCH_CHAR_LIMIT=3500

# open_url fetches pages directly (trafilatura extraction). When a site blocks
# the bot (403), serves a JS-only shell, or yields too little text, it retries
# through Jina Reader (https://r.jina.ai) automatically. Set false to disable.
# open_url 直接抓取失败（反爬/JS 页面/正文过少）时自动改走 Jina Reader 兜底，false 关闭
# JINA_FALLBACK=true
# Optional Jina API key for higher rate limits / 可选：Jina key，速率限制更宽松
# JINA_API_KEY=jina_xxxxxxxxxxxxxxxx

# Deep research: the research tool hands one task to every model listed here at once. Each one runs as a
# headless omp process (omp -p) that may only search and read public web pages; all reports go back to the
# reply model, which decides what to trust. Takes 30 s to 2 min per call, so the model only uses it for
# questions that need real checking. Needs omp in the image (the Dockerfile installs it) and the models'
# endpoint and key in ./omp/agent/models.yml (see README). Empty = off.
# 深入调研：research 工具把一个调研任务同时交给这里列出的每个模型（omp 的模型名，逗号分隔）。
# 每个模型起一个 omp 无界面进程，只能搜索和读公网网页；报告一起交给主模型判断信谁的。一次约 30 秒到 2 分钟，
# 模型只在需要认真查证时才用。需要镜像里装了 omp（Dockerfile 默认安装），并在 ./omp/agent/models.yml
# 配好模型的接口和 key（见 README）。留空关闭
# RESEARCH_MODELS=myclaude/claude-opus-5-5,mygemini/gemini-3.8-flash-high
# Backup per researcher (by position; one value = shared by all): a researcher that fails (not on timeout)
# is rerun once on its backup. 研究员的备选模型（按位置对应，只写一个则共用）：失败时（超时除外）换它再跑一次
# RESEARCH_FALLBACK_MODELS=backupclaude/claude-opus-5-5,backupgemini/gemini-3.8-flash-high
# Seconds each researcher may run before it is stopped / 单个研究员最多跑多少秒
# RESEARCH_TIMEOUT=150
# Researcher thinking level (omp --thinking) / 研究员的思考强度
# RESEARCH_THINKING=low
# Research tasks running at the same time / 同时最多几个调研任务
# RESEARCH_CONCURRENCY=2
# Keep one omp process per research model running (~200 MB each) so research starts at once instead of
# after a 10-15 s cold start; false = start omp for every task.
# 每个研究员模型常驻一个 omp 进程（每个约 200MB），接到任务立刻开工，省掉每次 10 到 15 秒的冷启动；false = 每次现启动
# RESEARCH_WARM=true
# omp executable / omp 可执行文件
# OMP_BIN=omp

# Super admin user IDs (comma-separated). Admins can always use the bot and
# manage the whitelist with /adduser /deluser /listusers.
# Setting this enables controlled mode: only admins + whitelisted users.
# 超级管理员 ID（逗号分隔）。配置后进入受控模式：仅管理员和白名单用户可用
ADMIN_USER_IDS=

# Initial whitelist (only used on first start, before allowed_users.json exists).
# Both empty = everyone can use the bot.
# 白名单初始值（仅首次启动生效，之后以 allowed_users.json 为准）；两者都留空 = 所有人可用
# ALLOWED_USER_IDS=123456789,987654321
